---
import CategoryPage from '../../../../components/pages/CategoryPage.astro';
import { categories } from '../../../../lib/data';
import { inLang } from '../../../../lib/i18n';
import { type ListPage, listPages } from '../../../../lib/pagination';

export function getStaticPaths() {
  return categories.flatMap((cat) => listPages(inLang(cat.videos, 'en')).map(({ page, props }) => ({ params: { slug: cat.slug, page }, props: { cat, list: props } })));
}
const { cat, list } = Astro.props as { cat: (typeof categories)[number]; list: ListPage };
---
<CategoryPage cat={cat} list={list} lang="en" />
