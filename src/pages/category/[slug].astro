---
import CategoryPage from '../../components/pages/CategoryPage.astro';
import { categories } from '../../lib/data';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props as { cat: (typeof categories)[number] };
---
<CategoryPage cat={cat} />
