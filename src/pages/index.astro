---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import SubscribeCTA from '../components/SubscribeCTA.astro';
import SearchForm from '../components/SearchForm.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ChannelStats from '../components/ChannelStats.astro';
import PendingCard from '../components/PendingCard.astro';
import { SITE, subscribeUrl } from '../lib/site';
import { videos, categories, popular, latest, pending } from '../lib/data';

// 新着: 記事がまだない動画（YouTube へのリンク）を先に、続けて記事を新しい順に。合わせて8本
const NEW_COUNT = 8;
const newPending = pending.slice(0, NEW_COUNT);
const newLatest = latest.slice(0, NEW_COUNT - newPending.length);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: Astro.site?.href, inLanguage: 'ja' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: Astro.site?.href, logo: new URL('/apple-touch-icon.png', Astro.site).href, sameAs: [SITE.channelUrl] },
];
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <p class="hero-kicker">YouTube 雑学チャンネル</p>
    <h1>{SITE.tagline}</h1>
    <p class="hero-lead">「なぜハチミツは腐らないの？」「なぜ雷は音が遅れて聞こえるの？」――<br />毎日の「なぜ？」を短い動画と読みもので解き明かします。</p>
    <SearchForm id="hero-q" />
    <div class="hero-actions">
      <a class="btn btn-sub" href={subscribeUrl} target="_blank" rel="noopener" data-ga-event="subscribe_click" data-ga-placement="hero">YouTubeでチャンネル登録</a>
      <a class="btn btn-ghost-light" href="/trivia/">雑学を読む（{videos.length}本）</a>
    </div>
    <ChannelStats tone="dark" />
  </section>

  <section class="section">
    <h2 class="section-title">よく見られている雑学</h2>
    <div class="grid">{popular.slice(0, 8).map((v) => <VideoCard video={v} />)}</div>
  </section>

  <section class="section">
    <h2 class="section-title">カテゴリから探す</h2>
    <div class="cat-grid">
      {categories.map((c) => (
        <a class="cat-tile" href={`/category/${c.slug}/`}>
          <span class="cat-badge"><CategoryIcon slug={c.slug} /></span>
          <span class="cat-name">{c.name}</span>
          <span class="cat-count">{c.videos.length}本</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">新着の雑学</h2>
    <div class="grid">
      {newPending.map((v) => <PendingCard video={v} />)}
      {newLatest.map((v) => <VideoCard video={v} />)}
    </div>
    <p class="more"><a href="/trivia/">すべての雑学を見る →</a></p>
  </section>

  <SubscribeCTA />
</Base>
