---
// 見出しの Zen Maru Gothic は自前で配信する（外部サービスに問い合わせない）。
// ここで読み込むのは pnpm dev 用の、削っていないフォント。公開するぶんは scripts/subset-fonts.mjs が
// ビルドのあとにこの @font-face を外し、ページごとに使う文字だけへ削って <head> に書き直す。
// 本文の BIZ UDPゴシックは配信せず、端末に入っていれば使う（global.css の --font）
import '@fontsource/zen-maru-gothic/700.css';
import '@fontsource/zen-maru-gothic/900.css';
import '../styles/global.css';
import { SITE, SITE_EN, GA_ID, subscribeUrl } from '../lib/site';
import { categories } from '../lib/data';
import SearchForm from '../components/SearchForm.astro';
import { UI, LANG_LABEL, type Lang, categoryName, localePath } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  /** アクセス解析でページをまとめる区分（記事ページの「詳細記事あり／なし」など） */
  contentGroup?: string;
  /** ページの言語。英語のページは /en/ の下に置く */
  lang?: Lang;
  /** 同じ内容の別の言語のページ。あるときはヘッダーに言語の切り替えを出し、hreflang でつなぐ */
  alternates?: Record<Lang, string>;
}
const { title, description = Astro.props.lang === 'en' ? SITE_EN.description : SITE.description, image = '/og-default.jpg', type = 'website', jsonLd = [], noindex = false, contentGroup, lang = 'ja', alternates } = Astro.props;
const t = UI[lang];
// トップは「雑学スイッチ 公式サイト」で名前を探す人に合わせる。ほかのページは「<ページ名>｜雑学スイッチ」
const fullTitle = lang === 'en' ? (title ? `${title} | ${t.siteName}` : `${t.siteName} | ${SITE_EN.tagline}`) : title ? `${title}｜${SITE.name}` : `${SITE.name} 公式サイト｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const langs = Object.keys(LANG_LABEL) as Lang[];
const p = (path: string) => localePath(lang, path);
// フッターの言語の切り替え。同じ内容のページがなければ、もう一方の言語のトップへ
const other: Lang = lang === 'en' ? 'ja' : 'en';
const otherHref = alternates?.[other] ?? localePath(other, '/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.ja, Astro.site)} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1b2a4a" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title ?? t.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
    {alternates && <meta property="og:locale:alternate" content={lang === 'en' ? 'ja_JP' : 'en_US'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {GA_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
    {GA_ID && (
      <script is:inline define:vars={{ gaId: GA_ID, contentGroup }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gaId, contentGroup ? { content_group: contentGroup } : {});
        // data-ga-event のついたリンク・ボタンが押されたらイベントを送る。data-ga-video-id="x" → video_id: "x"
        document.addEventListener('click', (e) => {
          const el = e.target instanceof Element && e.target.closest('[data-ga-event]');
          if (!el) return;
          const params = {};
          for (const [k, v] of Object.entries(el.dataset)) {
            if (k.startsWith('ga') && k !== 'gaEvent') params[k.slice(2).replace(/[A-Z]/g, (c, i) => (i ? '_' : '') + c.toLowerCase())] = v;
          }
          gtag('event', el.dataset.gaEvent, params);
        });
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : '本文へスキップ'}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={p('/')} class="logo">
          <img src="/icon.webp" alt="" width="36" height="36" />
          <span>{t.siteName}</span>
        </a>
        <SearchForm id="header-q" class="header-search" lang={lang} />
        <a class="header-search-icon" href={p('/search/')} aria-label={lang === 'en' ? 'Search trivia' : '雑学を検索'}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="m16.5 16.5 4.5 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        </a>
        {alternates && (
          <nav class="lang-switch" aria-label={t.languageNav}>
            {langs.map((l) => (l === lang
              ? <span lang={l} aria-current="page">{LANG_LABEL[l]}</span>
              : <a href={alternates[l]} lang={l} hreflang={l} data-ga-event="language_switch" data-ga-language={l}>{LANG_LABEL[l]}</a>))}
          </nav>
        )}
        {lang === 'en'
          ? <a class="btn btn-sub header-sub" href={subscribeUrl} target="_blank" rel="noopener" data-ga-event="subscribe_click" data-ga-placement="header">{t.subscribe}</a>
          : <a class="btn btn-sub header-sub" href={subscribeUrl} target="_blank" rel="noopener" data-ga-event="subscribe_click" data-ga-placement="header"><span class="header-sub-long">チャンネル</span>登録</a>}
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="footer-name">{t.siteName}</p>
            <p>{lang === 'en' ? SITE_EN.tagline : SITE.tagline}</p>
            <p class="footer-lang"><a href={otherHref} lang={other} hreflang={other} data-ga-event="language_switch" data-ga-language={other} data-ga-placement="footer">{LANG_LABEL[other]}</a></p>
          </div>
          <nav class="footer-nav" aria-labelledby="footer-cats">
            <p id="footer-cats" class="footer-nav-title">{lang === 'en' ? 'Categories' : 'カテゴリ'}</p>
            <ul>{categories.map((c) => <li><a href={p(`/category/${c.slug}/`)}>{categoryName(c.slug, lang)}</a></li>)}</ul>
          </nav>
          {lang === 'en' ? (
            <nav class="footer-nav" aria-labelledby="footer-site">
              <p id="footer-site" class="footer-nav-title">Site</p>
              <ul>
                <li><a href="/en/trivia/">All trivia</a></li>
                <li><a href="/en/search/">Search</a></li>
                <li><a href="/en/about/">About this site</a></li>
                <li><a href={SITE.contactUrl} target="_blank" rel="noopener">Contact <span class="lang-note">(form in Japanese)</span></a></li>
                <li><a href={SITE.channelUrl} target="_blank" rel="noopener" data-ga-event="channel_click" data-ga-placement="footer">YouTube</a></li>
              </ul>
            </nav>
          ) : (
            <nav class="footer-nav" aria-labelledby="footer-site">
              <p id="footer-site" class="footer-nav-title">サイト</p>
              <ul>
                <li><a href="/trivia/">雑学一覧</a></li>
                <li><a href="/search/">雑学を検索</a></li>
                <li><a href="/about/">このサイトについて</a></li>
                <li><a href={SITE.contactUrl} target="_blank" rel="noopener">お問い合わせ</a></li>
                <li><a href={SITE.channelUrl} target="_blank" rel="noopener" data-ga-event="channel_click" data-ga-placement="footer">YouTube</a></li>
              </ul>
            </nav>
          )}
          <nav class="footer-nav" aria-labelledby="footer-legal">
            <p id="footer-legal" class="footer-nav-title">{lang === 'en' ? 'Legal' : '規約'}</p>
            <ul>
              <li><a href={p('/privacy/')}>{lang === 'en' ? 'Privacy policy' : 'プライバシーポリシー'}</a></li>
              <li><a href={p('/terms/')}>{lang === 'en' ? 'Terms of use' : '利用規約'}</a></li>
            </ul>
          </nav>
        </div>
        <p class="footer-note">{lang === 'en'
          ? 'The Japanese videos and articles are made with the help of AI and checked by the site owner before publishing. English pages are translated from Japanese with AI and may contain mistakes.'
          : '動画と記事はAIを活用して制作し、公開前に運営者が確認しています。'}</p>
      </div>
    </footer>
    <script>
      import { startMotion } from '../lib/motion';
      // トップのイントロが流れているあいだは見出しのスイッチが見えないので、終わってから動かす
      if (document.documentElement.dataset.intro === 'play') {
        new MutationObserver((_, o) => {
          if (document.documentElement.dataset.intro) return;
          o.disconnect();
          startMotion();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-intro'] });
      } else {
        startMotion();
      }
    </script>
  </body>
</html>
