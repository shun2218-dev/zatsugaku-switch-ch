---
import Base from '../layouts/Base.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';
import Share from './Share.astro';
import Breadcrumb from './Breadcrumb.astro';
import CategoryIcon from './CategoryIcon.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import VideoCard from './VideoCard.astro';
import { SITE, reportUrl } from '../lib/site';
import { related, thumb, watchUrl } from '../lib/data';
import { type EnArticle, CATEGORY_NAME_EN, enArticleOf, enUrl, jaUrl } from '../lib/i18n';

// 雑学の記事の英語版（/en/trivia/<動画ID>/）。ルートは pages/en/trivia/[id].astro
interface Props { article: EnArticle }
const { article } = Astro.props;
const { video } = article;
const catName = CATEGORY_NAME_EN[video.category];
const catUrl = `/en/category/${video.category}/`;
const url = new URL(Astro.url.pathname, Astro.site);
const description = article.answer.slice(0, 160);
const dateOf = (d: string) => new Date(d).toLocaleDateString('en-US', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
const images = video.scenes.map((s) => s.image);
const readMinutes = Math.max(1, Math.round((article.scenes.map((x) => x.text).join(' ').split(/\s+/).length + (await article.html()).replace(/<[^>]+>/g, ' ').split(/\s+/).length) / 230));

// 本文の中の別の記事へのリンクは、英語版があればそちらへ。なければ日本語の記事だと分かるようにする
const body = (await article.html()).replace(/<a href="\/trivia\/([^/"]+)\/">([\s\S]*?)<\/a>/g, (_, id, text) =>
  enArticleOf(id)
    ? `<a href="${enUrl(id)}">${text}</a>`
    : `<a href="${jaUrl(id)}" hreflang="ja">${text}</a> <span class="lang-note">(in Japanese)</span>`,
);
// 目次: 「A closer look」の小見出し（本文の h3）
const headings = [...body.matchAll(/<h3 id="([^"]+)">([\s\S]*?)<\/h3>/g)].map(([, slug, html]) => ({ slug, text: html.replace(/<[^>]+>/g, '') }));
const relatedEn = related(video, 40).filter((v) => enArticleOf(v.id)).slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description,
    inLanguage: 'en',
    image: [new URL(thumb(video), Astro.site).href],
    datePublished: video.publishedAt,
    dateModified: article.updatedAt,
    author: { '@type': 'Organization', name: SITE.name, url: Astro.site?.href },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: url.href,
    translationOfWork: { '@type': 'Article', url: new URL(jaUrl(video.id), Astro.site).href, inLanguage: 'ja' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: article.title,
    description: article.description || description,
    inLanguage: 'ja',
    thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
    uploadDate: video.publishedAt,
    contentUrl: watchUrl(video),
    embedUrl: `https://www.youtube.com/embed/${video.id}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/en/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: catName, item: new URL(catUrl, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: article.title },
    ],
  },
];
---
<Base lang="en" title={article.title} description={description} image={thumb(video)} type="article" jsonLd={jsonLd} contentGroup="English article" alternates={{ ja: jaUrl(video.id), en: enUrl(video.id) }}>
  <Breadcrumb lang="en" items={[{ name: 'Home', href: '/en/' }, { name: catName, href: catUrl }, { name: article.title }]} />

  <article class="article">
    <p class="translation-note"><strong>AI translation.</strong> This article was translated from the <a href={jaUrl(video.id)} lang="ja" hreflang="ja">Japanese original</a> by AI{article.reviewedAt ? ' and checked by the site owner' : ', and may contain mistakes'}. The video is in Japanese.</p>

    <header class="article-head">
      <a class="card-cat" href={catUrl}><CategoryIcon slug={video.category} />{catName}</a>
      <h1>{article.title}</h1>
      <ul class="article-meta">
        <li>Video published <time datetime={video.publishedAt}>{dateOf(video.publishedAt)}</time></li>
        {article.translatedAt && <li>Translated by AI <time datetime={article.translatedAt}>{dateOf(`${article.translatedAt}T00:00:00+09:00`)}</time></li>}
        {article.reviewedAt && <li>Checked <time datetime={article.reviewedAt}>{dateOf(`${article.reviewedAt}T00:00:00+09:00`)}</time></li>}
        <li>{readMinutes} min read</li>
      </ul>
    </header>

    <div class="article-top">
      <YouTubeEmbed video={video} lang="en" />
      <div class="answer">
        <p class="answer-label"><span class="switch-mark" aria-hidden="true"></span>In short</p>
        <p class="answer-text">{article.answer}</p>
        <div class="answer-actions">
          <a class="btn btn-navy" href={watchUrl(video)} target="_blank" rel="noopener" data-ga-event="watch_click" data-ga-video-id={video.id}>Watch on YouTube<span class="visually-hidden"> (opens in a new tab)</span></a>
          {body && <a class="btn btn-ghost" href="#details">Read the details ↓</a>}
        </div>
      </div>
    </div>

    <div class="article-body">
      {body && (
        <details class="toc" open data-toc>
          <summary>On this page</summary>
          <ol>
            <li>
              <a href="#details">A closer look</a>
              {headings.length > 0 && <ol>{headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>}
            </li>
            <li><a href="#scenes">What the video says</a></li>
            {article.sources && article.sources.length > 0 && <li><a href="#sources">Sources</a></li>}
          </ol>
        </details>
      )}
      <script is:inline>if (matchMedia('(max-width: 959px)').matches) document.querySelector('[data-toc]')?.removeAttribute('open');</script>

      <div class="article-main">
        {body && (
          <section id="details" class="prose" aria-labelledby="details-title">
            <h2 id="details-title">A closer look</h2>
            <Fragment set:html={body} />
          </section>
        )}

        <details class="scenes-box" open>
          <summary><h2 id="scenes">What the video says</h2></summary>
          <ol class="scenes">
            {article.scenes.map((s, i) => (
              <li>
                {images[i] && <img src={images[i]} alt={s.alt} loading="lazy" decoding="async" width="720" height={video.format === 'short' ? 1260 : 411} class:list={{ wide: video.format === 'longform' }} />}
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </details>

        {article.sources && article.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            <ol>
              {article.sources.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noopener" lang={s.lang} hreflang={s.lang}>{s.title}</a>
                  {s.lang === 'ja' && <span class="lang-badge">Japanese</span>}
                  {s.titleEn && <span class="source-sub">“{s.titleEn}”</span>}
                  <span class="source-sub">{s.publisher}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        <div class="report">
          <p>Spotted a mistake in the article or the translation? Let us know.</p>
          <a class="btn btn-ghost" href={reportUrl(`${article.title}（${url.href}）`)} target="_blank" rel="noopener">Report an error<span class="visually-hidden"> (contact form in Japanese, opens in a new tab)</span></a>
        </div>

        <Share title={article.title} url={url} id={video.id} lang="en" />
      </div>
    </div>
  </article>

  <section class="section" aria-labelledby="related-title">
    <div class="section-head">
      <h2 id="related-title" class="section-title">More to read</h2>
      <p class="more"><a href={catUrl}>See all {catName.toLowerCase()} trivia →</a></p>
    </div>
    {relatedEn.length > 0 && <div class="grid">{relatedEn.map((v) => <VideoCard video={v} lang="en" />)}</div>}
  </section>

  <SubscribeCTA lang="en" />
</Base>
