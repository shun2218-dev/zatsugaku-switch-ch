---
// まだ記事にしていない公開動画の仮ページ（/trivia/<動画ID>/）。pnpm sync で記事に置き換わる。
// 中身は動画だけなので検索には出さない（noindex・サイトマップからも外す）
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';
import YouTubeEmbed from './YouTubeEmbed.astro';
import VideoCard from './VideoCard.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import { latest } from '../lib/data';
import type { YouTubeVideo } from '../lib/youtube';
interface Props { video: YouTubeVideo }
const { video } = Astro.props;
const dateLabel = new Date(video.publishedAt).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={video.title} description={`動画「${video.title}」の記事は準備中です。`} image={video.thumbnail} type="article" noindex>
  <Breadcrumb items={[{ name: 'ホーム', href: '/' }, { name: video.title }]} />

  <article class="article">
    <header class="article-head">
      <h1>{video.title}</h1>
      <p class="meta">動画公開: <time datetime={video.publishedAt}>{dateLabel}</time></p>
    </header>

    <div class="article-top">
      <YouTubeEmbed video={{ id: video.id, title: video.title, format: video.short ? 'short' : 'longform' }} />
      <div class="answer">
        <p class="answer-label">記事は準備中です</p>
        <p class="answer-text">この雑学の解説ページは、近日中に公開します。まずは動画でどうぞ。</p>
        <a class="btn btn-ghost" href={video.url} target="_blank" rel="noopener" data-ga-event="watch_click" data-ga-video-id={video.id}>YouTubeで見る</a>
      </div>
    </div>

    <SubscribeCTA />
  </article>

  <section class="section">
    <h2 class="section-title">新着の雑学</h2>
    <div class="grid">{latest.slice(0, 4).map((v) => <VideoCard video={v} />)}</div>
    <p class="more"><a href="/trivia/">すべての雑学を見る →</a></p>
  </section>
</Base>
