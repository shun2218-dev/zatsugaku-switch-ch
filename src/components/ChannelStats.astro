---
// チャンネル全体の数字（YouTube の公開データ）。取れなかったビルドでは何も出さない
import { youtube } from '../lib/youtube';
interface Props { tone?: 'dark' | 'light' }
const { tone = 'light' } = Astro.props;

// 1万以上は「12.8万」のように万でまとめる
const count = (n: number) =>
  n >= 10_000 ? `${(n / 10_000).toFixed(n >= 1_000_000 ? 0 : 1).replace(/\.0$/, '')}万` : n.toLocaleString('ja-JP');

const c = youtube?.channel;
const items = c
  ? [
      c.subscribers !== null && { label: 'チャンネル登録者', value: count(c.subscribers), unit: '人' },
      { label: '総再生回数', value: count(c.views), unit: '回' },
      { label: '公開中の動画', value: count(c.videos), unit: '本' },
      { label: '高評価（合計）', value: count(c.likes), unit: '件' },
    ].filter((i) => i !== false)
  : [];
const fetchedAt = youtube?.fetchedAt ?? '';
const asOf = fetchedAt
  ? new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(fetchedAt))
  : '';
---
{items.length > 0 && (
  <div class:list={['stats', `stats-${tone}`]}>
    <dl class="stats-list">
      {items.map((i) => (
        <div class="stats-item">
          <dt>{i.label}</dt>
          <dd><span class="stats-num">{i.value}</span>{i.unit}</dd>
        </div>
      ))}
    </dl>
    <p class="stats-note">YouTube の公開データ（<time datetime={fetchedAt}>{asOf}</time> 時点）</p>
  </div>
)}
