---
// 検索ページで、詳細記事の有無で検索結果を絞り込むボタン。件数と絞り込みは検索ページのスクリプトが行い、
// ここでは選んだ値を URL の ?note= に残す（一覧・カテゴリページは絞り込みごとのページへのリンク NoteFilterLinks.astro）
import { NOTE_FILTERS, NOTE_FILTER_TEXT } from '../lib/noteFilter';
import type { Lang } from '../lib/i18n';
interface Props { lang?: Lang }
const { lang = 'ja' } = Astro.props;
const text = NOTE_FILTER_TEXT[lang];
---
<div class="note-filter" role="radiogroup" aria-labelledby="note-filter-label" data-note-filter>
  <span id="note-filter-label" class="filter-label">{text.label}</span>
  {NOTE_FILTERS(lang).map(({ value, label }) => (
    <label class="note-filter-opt">
      <input type="radio" name="note" value={value} checked={value === 'all'} />
      <span class="note-filter-chip">{label}<span class="note-filter-count" data-count={value}></span></span>
    </label>
  ))}
</div>

<script>
  import { readNoteFilter, type NoteFilter } from '../lib/noteFilter';

  const box = document.querySelector<HTMLElement>('[data-note-filter]');
  if (box) {
    const initial = readNoteFilter();
    for (const r of box.querySelectorAll<HTMLInputElement>('input')) r.checked = r.value === initial;
    box.addEventListener('change', (ev) => {
      const f = (ev.target as HTMLInputElement).value as NoteFilter;
      const url = new URL(location.href);
      if (f === 'all') url.searchParams.delete('note');
      else url.searchParams.set('note', f);
      history.replaceState(null, '', url);
    });
  }
</script>
