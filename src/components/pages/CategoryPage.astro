---
// カテゴリの雑学（/category/<slug>/ と /en/category/<slug>/）
import Base from '../../layouts/Base.astro';
import VideoCard from '../VideoCard.astro';
import { EAGER_CARDS } from '../../lib/images';
import SubscribeCTA from '../SubscribeCTA.astro';
import Breadcrumb from '../Breadcrumb.astro';
import CategoryIcon from '../CategoryIcon.astro';
import NoteFilter from '../NoteFilter.astro';
import CategoryLinks from '../CategoryLinks.astro';
import type { categories } from '../../lib/data';
import { UI, type Lang, alternatesOf, categoryName, inLang, localePath, titleOf } from '../../lib/i18n';
interface Props { cat: (typeof categories)[number]; lang?: Lang }
const { cat, lang = 'ja' } = Astro.props;
const list = inLang(cat.videos, lang);
const name = categoryName(cat.slug, lang);
const title = lang === 'en' ? `${name} trivia` : `${name}の雑学`;
const description = lang === 'en'
  ? `${list.length} trivia articles about ${name.toLowerCase()}, such as ${list.slice(0, 3).map((v) => `“${titleOf(v, lang)}”`).join(', ')}.`
  : `${name}にまつわる雑学${list.length}本。${list.slice(0, 3).map((v) => `「${v.title}」`).join('')}など、思わず人に話したくなる「なぜ？」を解説します。`;
---
<Base lang={lang} title={title} description={description} alternates={alternatesOf(`/category/${cat.slug}/`)}>
  <Breadcrumb lang={lang} items={[{ name: lang === 'en' ? 'Home' : 'ホーム', href: localePath(lang, '/') }, { name }]} />
  <h1 class="page-title page-title-icon"><span class="cat-badge"><CategoryIcon slug={cat.slug} /></span>{title}<span>{UI[lang].count(list.length)}</span></h1>
  <CategoryLinks current={cat.slug} lang={lang} />
  <NoteFilter videos={list} lang={lang} />
  <div class="grid" data-note-grid>{list.map((v, i) => <VideoCard video={v} showCategory={false} lang={lang} eager={i < EAGER_CARDS} />)}</div>
  <SubscribeCTA lang={lang} />
</Base>
