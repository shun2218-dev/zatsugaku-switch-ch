---
// サイト内検索（/search/ と /en/search/）。目次（search-index.json）をブラウザで読み込んで絞り込む
import Base from '../../layouts/Base.astro';
import SearchForm from '../SearchForm.astro';
import NoteFilter from '../NoteFilter.astro';
import { topTags, searchUrl } from '../../lib/data';
import { type Lang, alternatesOf } from '../../lib/i18n';
interface Props { lang?: Lang }
const { lang = 'ja' } = Astro.props;
const title = lang === 'en' ? 'Search trivia' : '雑学を検索';
const description = lang === 'en' ? 'Search the trivia articles of Zatsugaku Switch by keyword.' : '雑学スイッチの雑学をキーワードで検索できます。';
---
<Base lang={lang} title={title} description={description} noindex alternates={alternatesOf('/search/')}>
  <h1 class="page-title">{title}</h1>
  <SearchForm id="search-page-q" class="search-page" autofocus lang={lang} />
  <NoteFilter lang={lang} />

  <div id="search-status" class="search-status" aria-live="polite"></div>
  <div id="search-results" class="grid search-results"></div>

  {/* タグは日本語しかないので、英語のページには出さない */}
  {lang === 'ja' && (
    <section id="search-suggest" class="section">
      <h2 class="section-title">よく出てくるテーマ</h2>
      <div class="tags">
        {topTags().map((t) => <a class="tag" href={searchUrl(t)}>#{t}</a>)}
      </div>
    </section>
  )}
</Base>

<script>
  import { norm } from '../../lib/normalize';
  import { iconSvg, noteIconSvg } from '../../lib/icons';
  import { imageSrcset, CARD_SIZES, EAGER_CARDS } from '../../lib/images';
  import { NOTE_FILTERS, NOTE_FILTER_TEXT, matchesNote, type NoteFilter } from '../../lib/noteFilter';

  // 画面の文言。ページの言語（<html lang>）で切り替える
  const lang = document.documentElement.lang === 'en' ? 'en' : 'ja';
  const T = {
    ja: {
      base: '',
      longform: 'じっくり解説',
      note: '詳細記事',
      filtered: (f: string, n: number) => `${f}の雑学 ${n}本`,
      hits: (q: string, n: number, f: string) => `「${q}」の雑学 ${n}本${f ? `（${f}）` : ''}`,
      noneInFilter: (q: string, f: string) => `「${q}」の雑学のうち、${f}のものは見つかりませんでした。`,
      none: (q: string) => `「${q}」に当てはまる雑学は見つかりませんでした。別のことばで探してみてください。`,
      loading: '読み込み中…',
    },
    en: {
      base: '/en',
      longform: 'Deep dive',
      note: 'In-depth',
      filtered: (f: string, n: number) => `${n} ${n === 1 ? 'result' : 'results'} (${f})`,
      hits: (q: string, n: number, f: string) => `${n} ${n === 1 ? 'result' : 'results'} for “${q}”${f ? ` (${f})` : ''}`,
      noneInFilter: (q: string, f: string) => `No results for “${q}” match the filter (${f}).`,
      none: (q: string) => `No results for “${q}”. Try a different word.`,
      loading: 'Loading…',
    },
  }[lang];
  // 英語は単語が長いので、抜き出す本文を広めにとる
  const SNIPPET = lang === 'en' ? { before: 70, after: 110 } : { before: 24, after: 56 };

  type Entry = { id: string; t: string; c: string; k: string; g: string[]; h: string; b: string; i: string; l: number; n: number; v: number };

  const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);

  const input = document.querySelector<HTMLInputElement>('#search-page-q')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  const suggest = document.querySelector<HTMLElement>('#search-suggest');
  const filterBox = document.querySelector<HTMLElement>('[data-note-filter]')!;
  const noteFilter = () => (filterBox.querySelector<HTMLInputElement>('input:checked')?.value ?? 'all') as NoteFilter;
  const filterLabel = (f: NoteFilter) =>
    lang === 'en'
      ? `${NOTE_FILTER_TEXT.en.label}: ${NOTE_FILTER_TEXT.en[f]}`
      : `詳細記事${NOTE_FILTER_TEXT.ja[f]}`;

  let index: (Entry & { nt: string; ng: string; nh: string; nb: string })[] = [];

  // 抜き出しの始まり。文の途中から「…」で始めると読みにくいので、一致した箇所を含む文の頭から始める。
  // 文が長くて一致箇所が見えなくなりそうなら、文の中の読点（、 ,）のあとから始める
  const SENTENCE_END = /^(?:[。！？!?]|\.\s)/;
  const CLAUSE_END = /^[、，,]/;
  function snippetStart(text: string, pos: number) {
    const after = (re: RegExp, from: number, limit: number) => {
      for (let i = from - 1; i >= limit; i--) if (re.test(text.slice(i, i + 2))) return i + 1;
      return limit === 0 ? 0 : -1;
    };
    const skipSpace = (i: number) => (/\s/.test(text[i] ?? '') ? skipSpace(i + 1) : i);
    const sentence = skipSpace(after(SENTENCE_END, pos, 0));
    if (pos - sentence <= SNIPPET.before) return sentence;
    const clause = after(CLAUSE_END, pos, Math.max(sentence, pos - SNIPPET.before));
    return clause >= 0 ? skipSpace(clause) : sentence;
  }

  // 本文の一致箇所のまわりを抜き出し、一致部分を <mark> で囲む
  function snippet(e: Entry & { nb: string }, terms: string[]) {
    const pos = Math.min(...terms.map((t) => e.nb.indexOf(t)).filter((p) => p >= 0));
    if (!Number.isFinite(pos)) return esc(e.h);
    // 正規化で文字数が変わった本文は位置がずれるので、ハイライトせず要約を出す
    if (e.nb.length !== e.b.length) return esc(e.h);
    const start = snippetStart(e.b, pos);
    const end = Math.min(e.b.length, Math.max(pos + SNIPPET.after, start + SNIPPET.before + SNIPPET.after));
    const marked = new Array<boolean>(end - start).fill(false);
    for (const t of terms) {
      for (let p = e.nb.indexOf(t, start); p >= 0 && p < end; p = e.nb.indexOf(t, p + 1)) {
        for (let k = p; k < Math.min(p + t.length, end); k++) marked[k - start] = true;
      }
    }
    let html = '';
    for (let k = 0; k < marked.length; ) {
      let j = k;
      while (j < marked.length && marked[j] === marked[k]) j++;
      const piece = esc(e.b.slice(start + k, start + j));
      html += marked[k] ? `<mark>${piece}</mark>` : piece;
      k = j;
    }
    return html + (end < e.b.length ? '…' : '');
  }

  // 絞り込みボタンの件数を、いまの検索語に当てはまる雑学の数にそろえる
  function updateCounts(entries: Entry[]) {
    for (const { value } of NOTE_FILTERS(lang)) {
      const el = filterBox.querySelector<HTMLElement>(`[data-count="${value}"]`);
      if (el) el.textContent = String(entries.filter((e) => matchesNote(e.n === 1, value)).length);
    }
  }

  function search(q: string) {
    const terms = norm(q).split(/[\s　]+/).filter(Boolean);
    const f = noteFilter();
    // 検索語がなくても「あり」「なし」を選んだら、当てはまる雑学をすべて出す
    if (suggest) suggest.hidden = terms.length > 0 || f !== 'all';
    if (!terms.length && f === 'all') {
      status.textContent = '';
      results.innerHTML = '';
      updateCounts(index);
      return;
    }
    const matched = index
      .map((e) => {
        let score = 0;
        for (const t of terms) {
          const s = (e.nt.includes(t) ? 10 : 0) + (e.ng.includes(t) ? 6 : 0) + (e.nh.includes(t) ? 3 : 0) + (e.nb.includes(t) ? 1 : 0);
          if (!s) return null; // すべての語を含むものだけ
          score += s;
        }
        return { e, score };
      })
      .filter((r): r is { e: (typeof index)[number]; score: number } => r !== null)
      .sort((a, b) => b.score - a.score || b.e.v - a.e.v);
    updateCounts(matched.map((r) => r.e));
    const hits = matched.filter((r) => matchesNote(r.e.n === 1, f));

    if (!terms.length) status.textContent = T.filtered(filterLabel(f), hits.length);
    else if (hits.length) status.textContent = T.hits(q, hits.length, f === 'all' ? '' : filterLabel(f));
    else if (matched.length) status.textContent = T.noneInFilter(q, filterLabel(f));
    else status.textContent = T.none(q);
    results.innerHTML = hits
      .map(
        ({ e }, i) => `
        <a class="card" href="${T.base}/trivia/${e.id}/">
          <div class="card-img"><img src="${e.i}"${imageSrcset(e.i) ? ` srcset="${imageSrcset(e.i)}" sizes="${CARD_SIZES}"` : ''} alt="" ${i < EAGER_CARDS ? 'fetchpriority="high"' : 'loading="lazy"'} decoding="async" width="720" height="1260" />${e.l ? `<span class="badge">${T.longform}</span>` : ''}</div>
          <div class="card-body"><div class="card-meta"><span class="card-cat">${iconSvg(e.k)}${esc(e.c)}</span>${e.n ? `<span class="note-badge">${noteIconSvg()}${T.note}</span>` : ''}</div><h3>${esc(e.t)}</h3><p class="card-snippet">${snippet(e, terms)}</p></div>
        </a>`,
      )
      .join('');
  }

  function run() {
    const q = input.value.trim();
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    search(q);
  }

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  status.textContent = input.value || noteFilter() !== 'all' ? T.loading : '';
  fetch(`${T.base}/search-index.json`)
    .then((r) => r.json())
    .then((data: Entry[]) => {
      index = data.map((e) => ({ ...e, nt: norm(e.t), ng: norm(e.g.join(' ')), nh: norm(e.h), nb: norm(e.b) }));
      search(input.value.trim());
    });

  filterBox.addEventListener('change', () => search(input.value.trim()));

  let timer: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(run, 150);
  });
  input.form!.addEventListener('submit', (ev) => {
    ev.preventDefault();
    run();
    input.blur();
  });
</script>
