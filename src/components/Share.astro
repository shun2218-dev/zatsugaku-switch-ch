---
import { UI, type Lang } from '../lib/i18n';
interface Props { title: string; url: string | URL; id?: string; lang?: Lang }
const { title, url, id, lang = 'ja' } = Astro.props;
const text = lang === 'en' ? `${title} | ${UI.en.siteName}` : `${title}｜雑学スイッチ`;
const label = {
  ja: { share: 'この雑学をシェア', post: 'でポスト', copy: 'リンクをコピー', copied: 'コピーしました', failed: 'コピーできませんでした' },
  en: { share: 'Share', post: 'Post on', copy: 'Copy link', copied: 'Copied', failed: 'Could not copy' },
}[lang];
const u = encodeURIComponent(String(url));
const t = encodeURIComponent(text);
---
<div class="share">
  <span class="share-label">{label.share}</span>
  {lang === 'en'
    ? <a class="share-btn x" href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener" data-ga-event="share" data-ga-method="x" data-ga-item-id={id}>{label.post}<img src="/brand/x-logo-white.svg" alt="X" width="14" height="14" /></a>
    : <a class="share-btn x" href={`https://x.com/intent/post?text=${t}&url=${u}`} target="_blank" rel="noopener" data-ga-event="share" data-ga-method="x" data-ga-item-id={id}><img src="/brand/x-logo-white.svg" alt="X" width="14" height="14" />{label.post}</a>}
  {/* LINE の公式ボタン画像は日本語版しか置いていないので、英語のページには出さない */}
  {lang === 'ja' && <a class="share-btn line" href={`https://social-plugins.line.me/lineit/share?url=${u}`} target="_blank" rel="noopener" data-ga-event="share" data-ga-method="line" data-ga-item-id={id}><img src="/brand/line-share-ja.png" alt="LINEで送る" width="261" height="60" /></a>}
  <button type="button" class="share-btn copy" data-url={String(url)} data-copied={label.copied} data-failed={label.failed} data-ga-event="share" data-ga-method="copy" data-ga-item-id={id}>{label.copy}</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share-btn.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url!);
        b.textContent = b.dataset.copied!;
      } catch {
        b.textContent = b.dataset.failed!;
      }
    }),
  );
</script>
