---
// パンくずリスト。最後の項目（いま見ているページ）はリンクにしない
import { UI, type Lang } from '../lib/i18n';
interface Props { items: { name: string; href?: string }[]; lang?: Lang }
const { items, lang = 'ja' } = Astro.props;
---
<nav class="breadcrumb" aria-label={UI[lang].breadcrumb}>
  <ol>
    {items.map((item, i) => (
      <li>
        {i === items.length - 1 || !item.href ? <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.name}</span> : <a href={item.href}>{item.name}</a>}
      </li>
    ))}
  </ol>
</nav>
